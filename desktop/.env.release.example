# Copy to .env.release (gitignored) and fill in to build a signed + notarized, distributable Hearth.
# scripts/release-macos.sh sources this. Everything here is YOUR Apple identity — never commit it.

# Your Developer ID Application identity. Find it with:  security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Kevin Champlin (744UXMUX79)"

# Apple ID used for notarization + an APP-SPECIFIC password (NOT your main password).
# Create the app-specific password at: appleid.apple.com > Sign-In & Security > App-Specific Passwords
APPLE_ID="you@example.com"
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
APPLE_TEAM_ID="744UXMUX79"

# When these three (APPLE_ID / APPLE_PASSWORD / APPLE_TEAM_ID) are set, `tauri build` notarizes
# and staples automatically. With only APPLE_SIGNING_IDENTITY set, you get a signed-but-not-
# notarized build (fine for your own machine; other Macs will still warn until notarized).
